# Ruby / Rails generated files
/.bundle/
/vendor/bundle/
/vendor/cache/
/.byebug_history
/.ruby-gemset
/.sass-cache/
/.cache/
/coverage/

# Environment and secrets
/.env
/.env.*
!.env.example
/config/*.key
/config/master.key
/config/credentials/*.key

# Log, tmp and cache files
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/storage/*
!/storage/.keep

# Public assets built by Rails
/public/assets
/public/packs
/public/manifest*.json
/public/uploads

# Database files
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-*
/storage/*.sqlite3
/storage/*.sqlite3-*

# Docker / local packaging artifacts
*.tar
*.tar.gz
.docker/

# Editor / OS junk
.vscode/
.idea/
*.swp
*.swo
*.tmp
.DS_Store
Thumbs.db

# Node / frontend leftovers if any appear later
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Windows metadata files created by Explorer
**/*.Zone.Identifier
**/*.zone.identifier

