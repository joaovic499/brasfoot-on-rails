<style>
  .menu-screen { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr); gap:16px; align-items:stretch; }
  .menu-feature { position:relative; min-height:440px; overflow:hidden; display:flex; flex-direction:column; justify-content:space-between; padding:clamp(30px,4vw,56px); border:1px solid rgba(166,224,72,.22); border-radius:10px; background:linear-gradient(115deg,rgba(9,18,13,.98) 0%,rgba(14,33,22,.94) 57%,rgba(21,50,31,.9) 100%); }
  .menu-feature::after { content:""; position:absolute; inset:0 0 0 48%; pointer-events:none; opacity:.14; background:repeating-linear-gradient(135deg,transparent 0 24px,#b8f04a 25px 26px,transparent 27px 52px); mask-image:linear-gradient(90deg,transparent,black); }
  .menu-feature > * { position:relative; z-index:1; }
  .menu-kicker { color:#b6e85e; font-size:10px; font-weight:900; letter-spacing:.2em; text-transform:uppercase; }
  .menu-feature h1 { max-width:600px; margin:22px 0 14px; color:#f3f8ee; font-size:64px; line-height:.98; text-transform:uppercase; }
  .menu-feature p { max-width:440px; margin:0; color:#a9c0ad; font-size:14px; line-height:1.6; }
  .menu-actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:26px; }
  .menu-action { min-height:46px; display:inline-flex; align-items:center; justify-content:center; padding:0 18px; border-radius:5px; border:1px solid rgba(255,255,255,.22); color:#f1f6ef; font-size:12px; font-weight:900; letter-spacing:.08em; text-decoration:none; text-transform:uppercase; }
  .menu-action.primary { color:#11180c; background:#b8eb50; border-color:#b8eb50; box-shadow:0 8px 22px rgba(169,225,69,.19); }
  .menu-action:hover { filter:brightness(1.1); transform:translateY(-1px); }
  .menu-status { display:flex; align-items:center; gap:14px; padding:18px; background:#101d15; border:1px solid rgba(255,255,255,.1); border-radius:8px; }
  .menu-status .team-crest,.menu-status .team-crest-fallback { flex:0 0 auto; }
  .menu-status-label { color:#85a08d; font-size:9px; font-weight:900; letter-spacing:.16em; text-transform:uppercase; }
  .menu-status strong { display:block; margin-top:5px; font-size:18px; }
  .menu-status p { margin:5px 0 0; color:var(--mut); font-size:12px; }
  .menu-options { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; margin-top:20px; border:1px solid rgba(255,255,255,.1); background:rgba(255,255,255,.1); }
  .menu-option { min-height:108px; display:flex; flex-direction:column; justify-content:space-between; padding:16px; color:var(--txt); background:#0c1711; text-decoration:none; transition:background .16s ease; }
  .menu-option:hover { background:#14251a; }
  .menu-option span { color:#819989; font-size:10px; font-weight:900; letter-spacing:.15em; }
  .menu-option strong { font-size:14px; }
  .menu-option small { color:#a4b8aa; font-size:11px; }
  .menu-side { display:flex; flex-direction:column; gap:12px; }
  .menu-side .menu-actions { margin:0; display:grid; gap:8px; }
  @media(max-width:850px) { .menu-screen { grid-template-columns:1fr; } .menu-feature { min-height:360px; } }
  @media(max-width:600px) { .menu-options { grid-template-columns:repeat(2,minmax(0,1fr)); } .menu-feature { min-height:330px; padding:26px 20px; } .menu-feature h1 { font-size:42px; } }
</style>

<section class="menu-screen">
  <div class="menu-feature">
    <div>
      <div class="menu-kicker">Brasfoot · La Liga · 2026/27</div>
      <h1>Menu<br>principal</h1>
      <p><%= @career ? "Sua carreira está salva. Continue de onde parou ou comece uma nova temporada." : "Monte seu clube, escale seu time e dispute o campeonato." %></p>
    </div>
    <div class="menu-actions">
      <% if @career %>
        <%= link_to "Carregar jogo", career_path, class: "menu-action primary" %>
      <% else %>
        <%= link_to "Iniciar novo jogo", new_game_path, class: "menu-action primary" %>
      <% end %>
      <%= link_to "Nova carreira", new_game_path, class: "menu-action" %>
    </div>
  </div>

  <div class="menu-side">
    <% if @career %>
      <div class="menu-status">
        <%= team_crest(@career.team, size: 54) %>
        <div><span class="menu-status-label">Carreira salva</span><strong><%= @career.team.name %></strong><p>Progresso guardado neste dispositivo</p></div>
      </div>
    <% else %>
      <div class="menu-status"><div><span class="menu-status-label">Nenhum jogo carregado</span><strong>Nova temporada</strong><p>Escolha um clube para começar sua carreira.</p></div></div>
    <% end %>
  </div>
</section>

<nav class="menu-options" aria-label="Ferramentas do jogo">
  <%= link_to players_path, class: "menu-option" do %><span>01 / EDITOR</span><strong>Editar jogadores</strong><small>Gerenciar dados e atributos</small><% end %>
  <%= link_to settings_path, class: "menu-option" do %><span>02 / SISTEMA</span><strong>Configurações</strong><small>Ajustar a experiência</small><% end %>
</nav>