<%# locals: team, by_slot, bench, form_url, banned_ids (opcional) %>
<% banned_ids = local_assigns[:banned_ids] || [] %>
<% match = local_assigns[:match] %>
<style>
  .squad-grid { display:grid; grid-template-columns:minmax(320px,540px) 1fr; gap:16px; align-items:start; }
  @media (max-width:820px){ .squad-grid { grid-template-columns:1fr; } }

  .pitch { position:relative; aspect-ratio:7/9; border:3px solid rgba(255,255,255,.35); border-radius:12px; overflow:hidden;
    background:repeating-linear-gradient(180deg,#2f8a3a 0 11.11%,#287a33 11.11% 22.22%); }
  .pitch .ln { position:absolute; border:2px solid rgba(255,255,255,.45); pointer-events:none; }
  .pitch .circle { left:35%; top:-12%; width:30%; aspect-ratio:1; border-radius:50%; }
  .pitch .box { left:20%; width:60%; bottom:0; height:17%; border-bottom:none; }
  .pitch .gbox { left:36%; width:28%; bottom:0; height:7%; border-bottom:none; }
  .pitch .midline { left:0; right:0; top:0; border-width:0 0 2px 0; }

  .slot { position:absolute; transform:translate(-50%,-50%); cursor:pointer; z-index:2; transition:transform .1s; }
  .slot:hover { transform:translate(-50%,-50%) scale(1.07); }
  .bcard { position:relative; cursor:pointer; }

  .fcard { position:relative; width:70px; height:92px; padding:0; text-align:center; border-radius:7px; overflow:hidden; cursor:pointer;
    box-shadow:0 4px 10px rgba(0,0,0,.5); border:1px solid rgba(255,255,255,.25); user-select:none; background:#18271f; }
  .fcard.has-photo::after { position:absolute; inset:0; content:""; z-index:1; background:linear-gradient(180deg,rgba(3,8,12,.08) 12%,rgba(3,8,12,.2) 42%,rgba(3,8,12,.94) 100%); pointer-events:none; }
  .fcard .face { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:50% 18%; }
  .fcard .face-placeholder { position:absolute; inset:0; display:grid; place-items:center; background:radial-gradient(ellipse at 50% 30%,#435c45,#17271d 72%); color:#d2ee9a; font-size:22px; font-weight:900; }
  .fcard .r { position:absolute; top:5px; left:5px; z-index:2; padding:1px 4px; border-radius:3px; background:#07110dcc; color:#fff; font-size:17px; font-weight:950; line-height:1.15; text-shadow:0 1px 3px #000; }
  .fcard .p { position:absolute; top:6px; right:5px; z-index:2; max-width:38px; overflow:hidden; color:#fff; font-size:9px; font-weight:900; text-shadow:0 1px 3px #000; white-space:nowrap; }
  .fcard .nm { position:absolute; left:0; right:0; bottom:0; z-index:2; overflow:hidden; padding:5px 3px 4px; border-top:1px solid rgba(255,255,255,.3); color:#fff; font-size:9px; font-weight:850; text-overflow:ellipsis; white-space:nowrap; text-shadow:0 1px 3px #000; }
  .fcard .pen { position:absolute; top:-8px; right:-8px; background:#d93025; color:#fff; font-size:10px; font-weight:900;
    z-index:3; border-radius:9px; padding:1px 5px; border:1px solid #fff; }
  .fcard.off .p { color:#b3261e; opacity:1; }
  .stamina-wrap { width:74px; margin:6px auto 0; }
  .stamina-bar { height:6px; width:100%; box-sizing:border-box; border-radius:999px; background:#111923; overflow:hidden; border:1px solid rgba(255,255,255,.28); box-shadow:0 1px 4px #0008; }
  .stamina-bar > span { display:block; height:100%; border-radius:inherit; transition:width .35s ease; }
  .stamina-wrap.is-good .stamina-bar > span { background:#b7f34a; box-shadow:0 0 7px #b7f34a99; }
  .stamina-wrap.is-warn .stamina-bar > span { background:#ffc928; box-shadow:0 0 7px #ffc92899; }
  .stamina-wrap.is-low .stamina-bar > span { background:#ff594f; box-shadow:0 0 7px #ff594f99; }
  .stamina-meta { display:flex; justify-content:space-between; align-items:center; min-height:11px; margin-top:3px; color:#f4f7fb; font-size:8px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; text-shadow:0 1px 2px #000; }
  .stamina-meta strong { font-size:9px; font-weight:900; }
  .stamina-wrap.is-warn .stamina-meta strong { color:#ffe17a; }
  .stamina-wrap.is-low .stamina-meta { color:#ffb0aa; }
  .stamina-alert { color:#ff6b61; }
  .t-elite  { background:linear-gradient(160deg,#16306b,#0b1a42); color:#ffd75e; border-color:#ffd75e; }
  .t-gold   { background:linear-gradient(160deg,#f7e08a,#d4a72c); color:#3b2d00; }
  .t-silver { background:linear-gradient(160deg,#eef1f4,#aab4bd); color:#26303a; }
  .t-bronze { background:linear-gradient(160deg,#e0b48a,#a8703a); color:#3a2208; }
  .t-elite.off .p { color:#ff8a80; }
  .fcard.empty { background:rgba(0,0,0,.35); color:#fff; border:2px dashed rgba(255,255,255,.7); box-shadow:none; }
  .fcard.empty .r { font-size:26px; }
  .fcard.empty .p { position:absolute; top:auto; right:0; bottom:24px; left:0; max-width:none; color:#fff; }

  .proj { position:absolute; left:50%; transform:translateX(-50%); bottom:-17px; z-index:5; background:#000c; color:#fff;
    font-size:11px; font-weight:800; padding:1px 7px; border-radius:9px; white-space:nowrap; pointer-events:none; }
  .proj:empty { display:none; }

  .selected .fcard { outline:3px solid #fff; box-shadow:0 0 14px #fff; }
  .target .fcard { outline:3px dashed #fff; }
  .dim { opacity:.3; }
  .banned { opacity:.35; filter:grayscale(1); cursor:not-allowed; }
  .banned .fcard { cursor:not-allowed; }

  .bench-group { margin-bottom:18px; }
  .bench-group h4 { margin:0 0 8px; color:var(--mut); font-size:12px; text-transform:uppercase; letter-spacing:1px; }
  .bench-cards { display:flex; flex-wrap:wrap; gap:10px 9px; padding-bottom:12px; }
  @media(max-width:600px) { .fcard { width:56px; height:76px; } .fcard .r { top:4px; left:4px; font-size:14px; } .fcard .p { top:5px; right:4px; max-width:30px; font-size:8px; } .fcard .nm { font-size:8px; padding:4px 2px 3px; } .stamina-wrap { width:58px; } }
</style>

<%= form_with url: form_url, method: :patch, id: "assign-form", data: { turbo: false } do %>
  <input type="hidden" name="slot">
  <input type="hidden" name="player_id">
<% end %>

<div class="squad-grid">
  <div class="pitch">
    <div class="ln midline"></div>
    <div class="ln circle"></div>
    <div class="ln box"></div>
    <div class="ln gbox"></div>

    <% team.slots.each_with_index do |(pos, x, y), i| %>
      <% pl = by_slot[i] %>
      <div class="slot" style="left:<%= x %>%; top:<%= y %>%;" data-slot="<%= i %>" data-slot-pos="<%= pos %>"<% if pl %> data-player-id="<%= pl.id %>" data-natural="<%= pl.position %>" data-ratings="<%= ratings_json(pl) %>"<% end %>>
        <% if pl %>
          <% rt = pl.rating_at(pos); pen = pl.penalty_at(pos) %>
          <div class="fcard has-photo <%= card_tier(rt) %><%= ' off' if pen > 0 %>" title="<%= pl.name %> — posições: <%= pl.positions.join('/') %> (<%= pl.overall %>). Jogando de <%= pos %>: <%= rt %>. <%= attrs_summary(pl) %>">
            <% if pl.base_template&.photo_url.present? %>
              <%= image_tag pl.base_template.photo_url, alt: pl.name, class: "face", loading: "lazy", referrerpolicy: "no-referrer" %>
            <% else %>
              <span class="face-placeholder"><%= pl.name.split.map { |part| part[0] }.first(2).join.upcase %></span>
            <% end %>
            <% if pen > 0 %><span class="pen">-<%= pen %></span><% end %>
            <div class="r"><%= rt %></div>
            <div class="p"><%= pen > 0 ? "#{pl.position}→#{pos}" : pos %></div>
            <div class="nm"><%= card_name(pl.name) %></div>
          </div>
          <% stamina_pct = match ? match.stamina_for(pl) : (100 - pl.fatigue.to_i).clamp(0, 100) %>
          <% stamina_state = stamina_pct < 35 ? "is-low" : stamina_pct < 65 ? "is-warn" : "is-good" %>
          <div class="stamina-wrap <%= stamina_state %>" data-stamina-player-id="<%= pl.id %>" title="Stamina: <%= stamina_pct %>% — fadiga: <%= pl.fatigue.to_i %>%" role="progressbar" aria-label="Stamina de <%= pl.name %>" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= stamina_pct %>">
            <div class="stamina-bar"><span style="width:<%= stamina_pct %>%"></span></div>
            <div class="stamina-meta"><span><%= stamina_pct < 35 ? "Energia baixa" : "Energia" %></span><strong><%= stamina_pct %>%</strong></div>
          </div>
        <% else %>
          <div class="fcard empty"><div class="r">+</div><div class="p"><%= pos %></div><div class="nm">vazio</div></div>
        <% end %>
        <div class="proj"></div>
      </div>
    <% end %>
  </div>

  <div class="card">
    <h2>Banco de reservas</h2>
    <% Positions::GROUP_NAMES.each do |grp, label| %>
      <% group = bench.select { |p| p.group == grp } %>
      <% next if group.empty? %>
      <div class="bench-group">
        <h4><%= label %></h4>
        <div class="bench-cards">
          <% group.each do |pl| %>
            <% out = banned_ids.include?(pl.id) %>
            <div class="bcard<%= ' banned' if out %>"<% unless out %> data-player-id="<%= pl.id %>" data-natural="<%= pl.position %>" data-ratings="<%= ratings_json(pl) %>"<% end %>>
              <div class="fcard has-photo <%= card_tier(pl.overall) %>" title="<%= pl.name %> — <%= pl.positions.join('/') %><%= ' (já saiu)' if out %>. <%= attrs_summary(pl) %>">
                <% if pl.base_template&.photo_url.present? %>
                  <%= image_tag pl.base_template.photo_url, alt: pl.name, class: "face", loading: "lazy", referrerpolicy: "no-referrer" %>
                <% else %>
                  <span class="face-placeholder"><%= pl.name.split.map { |part| part[0] }.first(2).join.upcase %></span>
                <% end %>
                <div class="r"><%= pl.overall %></div>
                <div class="p"><%= out ? "SAIU" : pl.positions.join("/") %></div>
                <div class="nm"><%= card_name(pl.name) %></div>
              </div>
              <% stamina_pct = match ? match.stamina_for(pl) : (100 - pl.fatigue.to_i).clamp(0, 100) %>
              <% stamina_state = stamina_pct < 35 ? "is-low" : stamina_pct < 65 ? "is-warn" : "is-good" %>
              <div class="stamina-wrap <%= stamina_state %>" data-stamina-player-id="<%= pl.id %>" title="Stamina: <%= stamina_pct %>% — fadiga: <%= pl.fatigue.to_i %>%" role="progressbar" aria-label="Stamina de <%= pl.name %>" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= stamina_pct %>">
                <div class="stamina-bar"><span style="width:<%= stamina_pct %>%"></span></div>
                <div class="stamina-meta"><span><%= stamina_pct < 35 ? "Energia baixa" : "Energia" %></span><strong><%= stamina_pct %>%</strong></div>
              </div>
              <div class="proj"></div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if bench.empty? %><p class="mut">Sem reservas.</p><% end %>
  </div>
</div>

<script>
(function () {
  var form = document.getElementById('assign-form');
  var fSlot = form.querySelector('[name=slot]');
  var fPlayer = form.querySelector('[name=player_id]');
  var items = [].slice.call(document.querySelectorAll('.slot, .bcard[data-player-id]'));
  var sel = null;

  function isSlot(el) { return el.dataset.slot !== undefined; }
  function ratings(el) { try { return JSON.parse(el.dataset.ratings); } catch (e) { return null; } }

  // Só goleiro joga no gol, e goleiro não joga na linha
  function gkOk(slotEl, playerEl) {
    return (slotEl.dataset.slotPos === 'GK') === (playerEl.dataset.natural === 'GK');
  }
  function compatible(a, b) {
    var sa = isSlot(a), sb = isSlot(b);
    if (sa && sb) {
      if (!a.dataset.natural && !b.dataset.natural) return false;
      if (a.dataset.natural && !gkOk(b, a)) return false;
      if (b.dataset.natural && !gkOk(a, b)) return false;
      return true;
    }
    if (sa) return gkOk(a, b);
    if (sb) return gkOk(b, a);
    return false; // banco x banco
  }

  function clear() {
    items.forEach(function (e) {
      e.classList.remove('selected', 'dim', 'target');
      var p = e.querySelector('.proj'); if (p) p.textContent = '';
    });
  }

  function select(el) {
    if (window.LiveMatch) window.LiveMatch.pause();   // mexer no time pausa o jogo
    sel = el; clear();
    el.classList.add('selected');
    items.forEach(function (o) {
      if (o === el) return;
      if (!compatible(el, o)) { o.classList.add('dim'); return; }
      o.classList.add('target');
      var val = null;
      if (isSlot(el) && !isSlot(o)) {            // reserva o assumiria a posição de el
        val = (ratings(o) || {})[el.dataset.slotPos];
      } else if (!isSlot(el) && isSlot(o)) {     // el assumiria a vaga o
        val = (ratings(el) || {})[o.dataset.slotPos];
      } else if (o.dataset.ratings) {            // dois do campo: o assumiria a vaga de el
        val = (ratings(o) || {})[el.dataset.slotPos];
      }
      var proj = o.querySelector('.proj');
      if (proj && val) proj.textContent = '→ ' + val;
    });
  }

  function send(slot, playerId) {
    fSlot.value = slot; fPlayer.value = playerId; form.submit();
  }

  items.forEach(function (el) {
    el.addEventListener('click', function () {
      if (sel === el) { sel = null; clear(); return; }
      if (!sel) { select(el); return; }
      if (!compatible(sel, el)) { select(el); return; }

      var a = sel, b = el;
      var aSlot = a.dataset.slot, bSlot = b.dataset.slot;
      var aP = a.dataset.playerId, bP = b.dataset.playerId;

      if (isSlot(a) && isSlot(b)) {              // campo x campo
        if (aP) send(bSlot, aP); else send(aSlot, bP);
      } else if (isSlot(a)) {                    // campo x banco
        send(aSlot, bP);
      } else {                                   // banco x campo
        send(bSlot, aP);
      }
    });
  });
})();
</script>
