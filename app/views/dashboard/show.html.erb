<% if @career.nil? %>
  <div class="card panel-hero">
    <div class="panel-header">
      <div>
        <p class="eyebrow"><%= @new_game ? "NOVA CARREIRA" : "MODO CARREIRA" %></p>
        <h2>Escolha seu time</h2>
      </div>
    </div>
    <p class="mut"><%= @replace_existing_career ? "Uma nova carreira substituirá o progresso salvo. Escolha seu clube para continuar." : "Campeonato de pontos corridos, turno e returno. Quem leva o título?" %></p>
    <div class="grid3 team-grid">
      <% @teams.each do |t| %>
        <% best = t.players.order(overall: :desc).to_a %>
        <div class="team-card" style="border-top:4px solid <%= t.color %>">
          <div class="team-card-head">
            <div class="team-card-crest"><%= team_crest(t, size: 52) %></div>
            <div>
              <h3><%= t.name %></h3>
              <div class="team-short"><%= t.short_name %></div>
            </div>
          </div>
          <p class="mut stadium"><%= t.stadium %></p>
          <div class="stats">
            <div><div class="mut">Geral</div><%= ovr_badge t.overall %></div>
            <div><div class="mut">Elenco</div><strong><%= best.size %></strong></div>
          </div>
          <div class="starline">
            <% best.first(3).each do |p| %>
              <div class="starline-row">
                <%= ovr_badge p.overall %>
                <span><%= p.name %></span>
              </div>
            <% end %>
          </div>
          <%= button_to(@replace_existing_career ? "Nova carreira · #{t.short_name}" : "Treinar #{t.short_name}",
                        start_path(team_id: t.id, replace_career: @replace_existing_career ? "1" : nil),
                        class: "btn",
                        form: { onsubmit: @replace_existing_career ? "return confirm('A carreira atual e seu progresso serão substituídos. Deseja continuar?')" : nil }) %>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <% team = @career.team %>
  <div class="card team-hero" style="border-left:6px solid <%= team.color %>">
    <div class="row hero-row">
      <div class="team-hero-head">
        <div class="team-card-crest"><%= team_crest(team, size: 64) %></div>
        <div>
          <p class="eyebrow">SEU CLUBE</p>
          <h2><%= team.name %></h2>
          <span class="mut"><%= team.stadium %></span>
        </div>
      </div>
      <div class="stats">
        <div><div class="mut">Geral</div><%= ovr_badge team.overall %></div>
        <div><div class="mut">Ataque</div><%= ovr_badge team.attack %></div>
        <div><div class="mut">Meio</div><%= ovr_badge team.sector("MF") %></div>
        <div><div class="mut">Defesa</div><%= ovr_badge team.defense %></div>
      </div>
    </div>
  </div>

  <% if @next_match %>
    <div class="card">
      <h2>Próxima partida — Rodada <%= @next_match.round %> de <%= @total_rounds %></h2>
      <div class="row" style="justify-content:space-between">
        <strong style="font-size:20px"><%= @next_match.home_team.name %> x <%= @next_match.away_team.name %></strong>
        <div class="row">
          <%= link_to(@next_match.in_progress? ? "▶ Continuar partida" : "▶ Jogar ao vivo", live_match_path(@next_match), class: "btn") %>
          <%= button_to "Simular rápido", play_round_path, class: "btn sec" %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="card">
      <h2>🏆 Temporada encerrada</h2>
      <% champ = @standings.first.team %>
      <p style="font-size:20px">Campeão: <strong><%= champ.name %></strong>
        <%= champ.id == team.id ? "— PARABÉNS, PROFESSOR! 🎉" : "" %></p>
    </div>
  <% end %>

  <% if @last_match %>
    <div class="card">
      <h2>Último resultado</h2>
      <%= link_to match_path(@last_match), style: "color:inherit;text-decoration:none" do %>
        <strong><%= @last_match.home_team.name %> <%= @last_match.home_goals %> x <%= @last_match.away_goals %> <%= @last_match.away_team.name %></strong>
      <% end %>
    </div>
  <% end %>

  <div class="card">
    <h2>Classificação</h2>
    <table>
      <tr><th>#</th><th>Time</th><th class="n">P</th><th class="n">J</th><th class="n">V</th><th class="n">E</th><th class="n">D</th><th class="n">GP</th><th class="n">GC</th><th class="n">SG</th></tr>
      <% @standings.each_with_index do |s, i| %>
        <tr class="<%= 'me' if s.team.id == team.id %>">
          <td><%= i + 1 %></td>
          <td>
            <span class="team-name-wrap">
              <span class="teamdot" style="background:<%= s.team.color %>"></span>
              <%= team_crest(s.team, size: 24, klass: "mini-crest") %>
              <%= s.team.name %>
            </span>
          </td>
          <td class="n"><strong><%= s.points %></strong></td>
          <td class="n"><%= s.played %></td><td class="n"><%= s.won %></td><td class="n"><%= s.drawn %></td><td class="n"><%= s.lost %></td>
          <td class="n"><%= s.gf %></td><td class="n"><%= s.ga %></td><td class="n"><%= s.gd %></td>
        </tr>
      <% end %>
    </table>
  </div>

  <%= button_to "Reiniciar carreira", reset_path, class: "btn sec", form: { onsubmit: "return confirm('Apagar tudo e recomeçar?')" } %>
<% end %>
